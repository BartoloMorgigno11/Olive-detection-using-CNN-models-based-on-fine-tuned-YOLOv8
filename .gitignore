# General Python ignores
__pycache__/
*.pyc
*.pyo
*.pyd
*.py[cod]
.venv/
neural_network/.train-venv/
neural_network/*.log

# General Node/React ignores
node_modules/
frontend/node_modules/
backend/node_modules/
frontend/build/
frontend/.cache/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# IDE and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/

# Environment files
.env
.env.*

# Runtime artifacts generated by the Flask backend
backend/upload/
backend/results/
backend/progress.json
backend/weights_summary.json
backend/weights_summary_normalized.json

# External dataset (not owned by the project author)
neural_network/data/
test/images/
frontend/example/

# Fine-tuned YOLOv8 weights and training artefacts
backend/yolov8/
neural_network/*.pt
neural_network/runs/

# Jupyter notebook checkpoints
**/.ipynb_checkpoints/

# Miscellaneous archives and binary bundles
*.zip
*.tar
*.tar.gz
